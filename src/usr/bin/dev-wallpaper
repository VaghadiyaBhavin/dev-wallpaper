#!/usr/bin/env python3
"""dev-wallpaper: generate a developer-themed GNOME wallpaper, still or animated.

Settings are read from ~/.config/dev-wallpaper/config (written by dev-wallpaper-setup).
Run by the dev-wallpaper.timer systemd user unit.
"""
import os, random, re, subprocess, sys
from PIL import Image, ImageDraw, ImageFont, ImageFilter

VERSION = "1.0.2"
MONO = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
MONO_B = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
CONFIG = os.path.expanduser("~/.config/dev-wallpaper/config")
OUT_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "dev-wallpaper")

DEFAULTS = {
    "ANIMATED": "yes",       # yes | no
    "INTERVAL": "30",        # minutes between new designs (used by the timer)
    "TYPING_SPEED": "1",     # seconds per typed line (GNOME's minimum step is 1s)
    "THEMES": "all",         # all | comma list of theme names
    "LANGUAGES": "all",      # all | comma list of language names
    "RESOLUTION": "auto",    # auto | WIDTHxHEIGHT
}

# Canvas width; height follows the screen's aspect ratio
W = 3840
H = 2400

# Palettes: bg top/bottom, glow1, glow2, window, titlebar, and syntax colors
