[Unit]
Description=Change the developer wallpaper periodically

[Timer]
OnStartupSec=1min
OnActiveSec=1min
# Overridden per user by ~/.config/systemd/user/dev-wallpaper.timer.d/interval.conf.
# That drop-in resets all timers, so it must repeat OnStartupSec/OnActiveSec too.
OnUnitActiveSec=30min
AccuracySec=1s

[Install]
WantedBy=timers.target
